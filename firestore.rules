rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isTfbUser() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('.*@teachforbangladesh\\.org$');
    }

    function isPlanner() {
      return isTfbUser()
        && (request.auth.token.email in [
            'mehdi@teachforbangladesh.org',
            'asifur@teachforbangladesh.org',
            'hasibur@teachforbangladesh.org'
          ]
          || (request.auth.token.keys().hasAny(['role'])
            && request.auth.token.role in ['superadmin', 'planner', 'resource_planner']));
    }

    function isSuperadmin() {
      return isTfbUser()
        && (request.auth.token.email == 'mehdi@teachforbangladesh.org'
          || (request.auth.token.keys().hasAny(['role'])
            && request.auth.token.role == 'superadmin'));
    }

    function isPresenceAdmin() {
      return isTfbUser()
        && (isPlanner()
          || (request.auth.token.keys().hasAny(['role'])
            && request.auth.token.role in ['afa', 'coach'])
          || (request.auth.token.keys().hasAny(['access'])
            && request.auth.token.access in ['full', 'fellows'])
          || (request.auth.token.keys().hasAny(['adminPanel'])
            && request.auth.token.adminPanel == true));
    }

    // [CITY] Fellow roster management. Fellows are added from the Admin panel by
    // AFA, Coach and Admin (full-access) roles as well as the Superadmin.
    function isFellowManager() {
      return isTfbUser()
        && (isSuperadmin()
          || (request.auth.token.keys().hasAny(['role'])
            && request.auth.token.role in ['planner', 'resource_planner', 'academy_lead', 'afa_lead',
              'curriculum_specialist', 'placement_ops', 'afa', 'coach', 'city_lead']));
    }

    match /wa14/{docId} {
      allow read: if isTfbUser();
      allow create, update, delete: if isPlanner()
        && docId in ['wa14-sessions', 'wa14-rooms', 'wa14-pillars', 'wa14-requests', 'wa14-settings', 'wa14-assessments', 'wa14-assessment-questions', 'wa14-assessment-analytics', 'wa14-staff-tasks',
          // Practice-teaching collaborations + grade/subject learning outcomes + manual session marks.
          'wa14-collaborations', 'wa14-learning-outcomes', 'wa14-session-marks',
          // [CITY] City system documents (year-round fellowship calendar).
          'wa14-city-sessions', 'wa14-city-staff-tasks', 'wa14-city-settings', 'wa14-city-types', 'wa14-city-modes'];
      allow create, update, delete: if isFellowManager()
        && docId == 'wa14-roster';
      allow create, update, delete: if isTfbUser()
        && docId in ['wa14-assessment-attempts', 'wa14-attendance'];
      allow create, update, delete: if isSuperadmin()
        && docId in ['wa14-accounts', 'wa14-planners'];
    }

    match /calendarPresence/{presenceId} {
      allow get, list: if isPresenceAdmin()
        || (isTfbUser() && resource.data.uid == request.auth.uid);
      allow create, update: if isTfbUser()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.keys().hasAll(['uid', 'email', 'name', 'role', 'system', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['uid', 'email', 'name', 'role', 'system', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.role is string
        && request.resource.data.system in ['winter_academy', 'city', 'system_picker']
        && request.resource.data.updatedAt == request.time;
      allow delete: if isTfbUser() && resource.data.uid == request.auth.uid;
    }

    match /loginAudit/{eventId} {
      allow create: if isTfbUser()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.keys().hasAll([
          'uid', 'email', 'type', 'system', 'deviceType', 'browser', 'platform', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'type', 'system', 'deviceType', 'browser', 'platform', 'createdAt'
        ])
        && request.resource.data.type in ['session_start', 'system_enter', 'system_switch', 'sign_out']
        && request.resource.data.system in ['winter_academy', 'city', 'system_picker', 'unknown']
        && request.resource.data.deviceType in ['desktop', 'tablet', 'mobile', 'unknown']
        && request.resource.data.browser in ['Chrome', 'Edge', 'Firefox', 'Safari', 'Opera', 'Other']
        && request.resource.data.platform in ['Windows', 'macOS', 'iOS', 'Android', 'ChromeOS', 'Linux', 'Other']
        && request.resource.data.createdAt == request.time;
      allow get, list: if isPresenceAdmin();
      allow update: if false;
      allow delete: if isPresenceAdmin();
    }
  }
}
